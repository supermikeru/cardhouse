# Реальные значения — только в bot/.env (не коммитится) и в Environment на Render.
# Не копируйте сюда настоящие секреты.

# Тот же токен, что уже используется в site/telegram-config.php
BOT_TOKEN=123456789:AA...

# Через запятую, без пробелов — Telegram user_id администраторов клуба
ADMIN_CHAT_IDS=429145446,259213648,162468802

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Любая случайная строка, например: openssl rand -hex 20
WEBHOOK_SECRET=change-me

# На Render не нужно — RENDER_EXTERNAL_URL подставляется автоматически.
# Для локального запуска/иного хостинга укажите публичный https-адрес явно.
WEBHOOK_BASE_URL=

PORT=10000

# Username бота без @ и короткое имя мини-аппа (из @BotFather -> /newapp) —
# нужны для кнопки "Записаться на игру" в анонсах.
BOT_USERNAME=your_bot_username
MINIAPP_SHORT_NAME=app
